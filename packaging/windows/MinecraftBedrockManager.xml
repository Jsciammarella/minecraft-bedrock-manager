<service>
  <id>MinecraftBedrockManager</id>
  <name>Minecraft Bedrock Manager</name>
  <description>Web console for Minecraft Bedrock dedicated servers on this PC.</description>
  <executable>%BASE%\runtime\node\node.exe</executable>
  <arguments>"%BASE%\server\index.js"</arguments>
  <workingdirectory>%BASE%</workingdirectory>
  <stoptimeout>25sec</stoptimeout>
  <onfailure action="restart" delay="10 sec" />
  <resetfailure>1 hour</resetfailure>
  <env name="NODE_ENV" value="production" />
  <env name="PORT" value="3000" />
  <env name="MC_MANAGER_JAVA" value="%BASE%\runtime\jre\bin\java.exe" />
  <env name="JAVA_HOME" value="%BASE%\runtime\jre" />
  <env name="MC_MANAGER_PYTHON" value="%BASE%\runtime\python\python.exe" />
  <env name="MC_MANAGER_GIT" value="%BASE%\runtime\git\cmd\git.exe" />
  <env name="PATH" value="%BASE%\runtime\node;%BASE%\runtime\jre\bin;%BASE%\runtime\python;%BASE%\runtime\git\cmd;%BASE%\runtime\git\mingw64\bin;%PATH%" />
  <logpath>%BASE%\data\logs\service</logpath>
  <logmode>roll</logmode>
</service>
