# ============================================
# Minecraft Bedrock Server Manager
# Environment Configuration
# ============================================

# ---- Application ----
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# ---- CurseForge Catalog ----
# Get your API key at https://console.curseforge.com/
# CurseForge currently challenges automated web requests, so a key is recommended
# for reliable catalog search and programmatic downloads. You can also paste the
# key in Mod Catalog → Settings.
CURSEFORGE_API_KEY=

# ---- Git Mod Catalog ----
# Optional Git repository of Bedrock packs (GitLab, GitHub, Gitea, ...).
# Preferred configuration is Mod Catalog → Settings. These values are used
# only when the corresponding setting has not been saved in the UI.
# See docs/git-mod-catalog.md for the repository layout.
GIT_CATALOG_ENABLED=
GIT_CATALOG_URL=
GIT_CATALOG_BRANCH=main
GIT_CATALOG_USERNAME=
GIT_CATALOG_TOKEN=
GIT_CATALOG_SUBDIR=

# ---- File Mod Catalog ----
# Optional local folder, SMB share, and/or NFS mount of Bedrock packs.
# Preferred configuration is Mod Catalog → Settings. Same layout as Git.
# See docs/file-mod-catalog.md. Leave FILE_CATALOG_LOCAL_PATH blank to use a writable default
# (Windows Public Documents, Docker /catalog, or data/catalog on native Linux).
FILE_CATALOG_ENABLED=
FILE_CATALOG_LOCAL_ENABLED=
FILE_CATALOG_LOCAL_PATH=
FILE_CATALOG_SMB_ENABLED=
FILE_CATALOG_SMB_PATH=
FILE_CATALOG_SMB_USERNAME=
FILE_CATALOG_SMB_PASSWORD=
FILE_CATALOG_NFS_ENABLED=
FILE_CATALOG_NFS_PATH=
# Catalog download file picking: manual (default) or auto
CATALOG_MULTI_FILE_MODE=

# How often the manager pulls the Git catalog in the background (hours)
GIT_CATALOG_SYNC_HOURS=2

# ---- Auto Update Scheduler ----
# Interval in seconds between automatic update checks (default: 86400 = 24 hours)
AUTO_UPDATE_CHECK_INTERVAL=86400

# ---- Connect address ----
# Optional IPv4 shown on dashboard tiles for Minecraft clients.
# Leave empty to auto-detect this host's LAN address. Hostnames are ignored
# because Bedrock Connect is more reliable with an IP. Set this only when
# running without host networking (for example Docker Desktop) so tiles do
# not show a container IP such as 172.17.0.2.
CONNECT_HOST=

# ---- Timezone ----
# Leave unset so Docker and a native install both use the host timezone.
# Docker reads /etc/localtime from the host. Set TZ only to override that,
# for example America/Denver or UTC.
# TZ=

# ---- Database ----
# SQLite database is stored in data/servers/mc_manager.db
# No additional configuration needed

