# ============================================
# Minecraft Bedrock Server Manager
# Environment Configuration
# ============================================

# ---- Application ----
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# ---- CurseForge Catalog ----
# Get your API key at https://support.curseforge.com/en/articles/8909681-developer-api-key
# CurseForge currently challenges automated web requests, so a key is required
# for reliable catalog search and programmatic downloads.
CURSEFORGE_API_KEY=

# ---- Auto Update Scheduler ----
# Interval in seconds between automatic update checks (default: 86400 = 24 hours)
AUTO_UPDATE_CHECK_INTERVAL=86400

# ---- Timezone ----
TZ=UTC

# ---- Database ----
# SQLite database is stored in data/servers/mc_manager.db
# No additional configuration needed

