{
  "id": "catalog-curseforge",
  "name": "CurseForge Catalog",
  "version": "1.0.0",
  "author": "Minecraft Bedrock Manager",
  "description": "Adds Minecraft Bedrock and Java projects from CurseForge to the Mod Catalog. Both sources share one API key.",
  "pages": [
    {
      "id": "settings",
      "title": "CurseForge Catalog",
      "renderer": "native-settings"
    }
  ],
  "menu": {
    "label": "CurseForge Catalog",
    "icon": "package",
    "order": 40,
    "page": "settings"
  },
  "backend": "backend.js",
  "capabilities": [
    "provider:catalog-source",
    "catalog:metadata",
    "download:catalog-sources"
  ],
  "downloadHosts": [
    "api.curseforge.com",
    "forgecdn.net",
    "edge.forgecdn.net",
    "mediafilez.forgecdn.net",
    "media.forgecdn.net"
  ],
  "providers": [
    {
      "type": "catalog-source",
      "id": "curseforge-bedrock",
      "name": "CurseForge Bedrock",
      "edition": "bedrock"
    },
    {
      "type": "catalog-source",
      "id": "curseforge-java",
      "name": "CurseForge Java",
      "edition": "java"
    }
  ]
}
