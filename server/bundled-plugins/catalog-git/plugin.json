{
  "id": "catalog-git",
  "name": "Git Catalog",
  "version": "1.0.0",
  "author": "Minecraft Bedrock Manager",
  "description": "Adds a private or public Git repository of Bedrock and Java packs to the Mod Catalog.",
  "pages": [
    {
      "id": "settings",
      "title": "Git Catalog",
      "renderer": "native-settings"
    }
  ],
  "menu": {
    "label": "Git Catalog",
    "icon": "cloud",
    "order": 41,
    "page": "settings",
    "permission": "catalog.git.configure"
  },
  "permissions": [
    {
      "key": "catalog.git.configure",
      "displayName": "Configure Git catalog",
      "description": "Enable and configure the Git catalog repository.",
      "primaryCategory": "catalog",
      "riskLevel": "elevated"
    },
    {
      "key": "catalog.git.sync",
      "displayName": "Sync Git catalog",
      "description": "Run a Git catalog sync now.",
      "primaryCategory": "catalog",
      "riskLevel": "normal"
    }
  ],
  "backend": "backend.js",
  "capabilities": [
    "provider:catalog-source",
    "catalog:metadata",
    "download:catalog-sources"
  ],
  "providers": [
    {
      "type": "catalog-source",
      "id": "git",
      "name": "Git Repository",
      "editions": ["bedrock", "java"]
    }
  ]
}
